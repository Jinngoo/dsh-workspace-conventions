{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024"],
    "outDir": "lib",
    // The package root, not `src`: the host entry is `index.ts` at the root so
    // that `exports["./client"]` can name a hand-written browser bundle beside it
    // without the browser file having to be a `rootDir` member tsc would compile.
    "rootDir": ".",
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": ["index.ts", "src"]
}
